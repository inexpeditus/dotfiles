[colors.primary]
background = "#282828"
foreground = "#ebdbb2"
# dim_foreground = "#a89984"      # optional, auto-derived if unset
# bright_foreground = "#fbf1c7"   # optional, used for bold text

# The 16 ANSI colors programs use (ls, git, prompts, vim, etc.)
[colors.normal]
black   = "#282828"
red     = "#cc241d"
green   = "#98971a"
yellow  = "#d79921"
blue    = "#458588"
magenta = "#b16286"
cyan    = "#689d6a"
white   = "#a89984"

[colors.bright]
black   = "#928374"
red     = "#fb4934"
green   = "#b8bb26"
yellow  = "#fabd2f"
blue    = "#83a598"
magenta = "#d3869b"
cyan    = "#8ec07c"
white   = "#ebdbb2"

# [colors.dim]   # optional, same 8 keys as normal; auto-derived if unset

[colors.cursor]
text   = "CellBackground"   # special values: CellForeground / CellBackground
cursor = "CellForeground"

[colors.vi_mode_cursor]
text   = "CellBackground"
cursor = "CellForeground"

[colors.selection]
text       = "CellBackground"
background = "CellForeground"

[colors.search.matches]
foreground = "#282828"
background = "#fabd2f"

[colors.search.focused_match]
foreground = "#282828"
background = "#fe8019"

[colors.hints.start]
foreground = "#282828"
background = "#fabd2f"

[colors.hints.end]
foreground = "#282828"
background = "#ebdbb2"

[colors.footer_bar]          # search bar at the bottom
foreground = "#282828"
background = "#ebdbb2"

[colors.line_indicator]      # scrollback position indicator
foreground = "None"
background = "None"

[colors]
draw_bold_text_with_bright_colors = false
transparent_background_colors = false
