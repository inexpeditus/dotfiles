bar {
  status_command i3blocks -c ~/.config/i3/blocks.conf
  font pango:Terminess Nerd Font Propo 12
  #font pango : monospace 16
    # colors {
    #    background #1d1f21  # Replace with your desired color
    #    statusline #ffffff  # Text color for the status line
    #    separator #666666   # Separator color
    # }
        tray_output primary
            colors {
            background #000000
            statusline #FFF5E0

            separator #ef8513
            focused_workspace #000000 #DF8320 #000000
            active_workspace  #000000 #000000 #000000
            inactive_workspace #000000 #000000 #ffffff
            urgent_workspace  #e06c75 #000000 #ffffff
            binding_mode #00000 #00000 #ffffff
    }
}

# Volume keys; the signal makes the i3blocks mute indicator refresh immediately.
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +2% && pkill -RTMIN+10 i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -2% && pkill -RTMIN+10 i3blocks
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+10 i3blocks

bindsym Print exec --no-startup-id flameshot gui
exec_always --no-startup-id xrandr --output eDP1 --mode 1920x1200
